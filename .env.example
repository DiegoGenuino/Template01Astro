# Credencial específica deste cliente/repositório (usada somente durante o build).
# Mantenha em .env.local, sem PUBLIC_ e fora do Git.
# deploy:vercel a cadastra como Secret/Sensitive em Production na Vercel.
# Também pode ser cadastrada só no painel Vercel: vazio aqui preserva a variável remota.
GOOGLE_PLACES_API_KEY=
