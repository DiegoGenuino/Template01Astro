---
import ArrowUpRightIcon from '@/components/ArrowUpRightIcon.astro';
import BrandMark from '@/components/BrandMark.astro';
import { siteConfig } from '@/config/site';

const { contact, header } = siteConfig;
---

<header class="site-header" data-header>
  <div class="nav-shell">
    <a class="brand" href={header.brandHref} aria-label={header.brandLabel}>
      <BrandMark />
    </a>

    <nav class="desktop-nav" aria-label={header.primaryNavigationLabel}>
      {header.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a class="nav-cta" href={contact.whatsappUrl} target="_blank" rel="noreferrer">
      {contact.primaryCtaLabel}
      <span aria-hidden="true"><ArrowUpRightIcon /></span>
    </a>

    <button class="menu-toggle" type="button" aria-label={header.menuOpenLabel} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-menu" aria-label={header.mobileNavigationLabel} data-mobile-menu>
    {header.links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="button button-primary" href={contact.whatsappUrl} target="_blank" rel="noreferrer">{contact.primaryCtaLabel} <ArrowUpRightIcon /></a>
  </nav>
</header>
