---
import { siteConfig } from '@/config/site';

const section = siteConfig.processSection;
const total = section.items.length;
const panelVariants = ['light', 'surface', 'blue', 'dark'];
---

<section class="process-section" id={section.id}>
  <div class="section process-intro">
    <div class="container process-intro-grid" data-reveal>
      <h2 class="spotlight-text">{section.title}<br /><span>{section.highlightedTitle}</span></h2>
      <p>{section.description}</p>
    </div>
  </div>

  <ol class="process-stack" aria-label={section.stepsLabel} data-process-stack>
    {section.items.map((item, index) => {
      const stepNumber = String(index + 1).padStart(2, '0');
      const panelVariant = panelVariants[index % panelVariants.length];
      return (
        <li
          class={`process-step process-step-${panelVariant}`}
          style={`--stack-index: ${index + 1}; --step-completion: ${((index + 1) / total) * 100}%`}
          aria-labelledby={`process-step-${index + 1}`}
          data-process-step
        >
          <div class="container process-step-grid">
            <div
              class="process-step-meta"
              aria-label={`${section.stepLabel} ${index + 1} de ${total}`}
            >
              <span aria-hidden="true">{section.stepLabel}</span>
              <strong aria-hidden="true">{stepNumber}</strong>
              <small aria-hidden="true">de {String(total).padStart(2, '0')}</small>
            </div>

            <div class="process-step-copy">
              <h3 id={`process-step-${index + 1}`}>{item.title}</h3>
              <p>{item.description}</p>
            </div>

            <p class="process-step-detail">{item.detail}</p>

            <div class="process-progress" aria-hidden="true">
              <span></span>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<script>
  const processSteps = [...document.querySelectorAll<HTMLElement>('[data-process-step]')];
  const reduceProcessMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (processSteps.length > 1 && !reduceProcessMotion) {
    let processFrame = 0;

    const updateProcessStack = () => {
      processFrame = 0;
      const viewportHeight = Math.max(window.innerHeight, 1);

      processSteps.forEach((step, index) => {
        const nextStep = processSteps[index + 1];
        if (!nextStep) {
          step.style.setProperty('--stack-progress', '0');
          return;
        }

        const nextTop = nextStep.getBoundingClientRect().top;
        const progress = Math.min(1, Math.max(0, (viewportHeight - nextTop) / viewportHeight));
        step.style.setProperty('--stack-progress', progress.toFixed(4));
      });
    };

    const requestProcessUpdate = () => {
      if (processFrame) return;
      processFrame = window.requestAnimationFrame(updateProcessStack);
    };

    window.addEventListener('scroll', requestProcessUpdate, { passive: true });
    window.addEventListener('resize', requestProcessUpdate, { passive: true });
    window.requestAnimationFrame(updateProcessStack);
  }
</script>
