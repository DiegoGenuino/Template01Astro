---
import { siteConfig } from '@/config/site';
import type { FaqItem } from '@/config/site';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  faqItems?: FaqItem[];
}

const {
  title,
  description = siteConfig.seo.defaultDescription,
  canonical,
  image = siteConfig.seo.defaultImage,
  imageAlt = siteConfig.seo.defaultImageAlt,
  type = 'website',
  noindex = false,
  faqItems = [],
} = Astro.props;

const seo = siteConfig.seo;
const identity = siteConfig.identity;
const aiDiscovery = siteConfig.aiDiscovery;
const resolvedTitle = title ? seo.titleTemplate.replace('%s', title) : seo.defaultTitle;
const canonicalUrl = new URL(canonical || Astro.url.pathname, seo.siteUrl).toString();
const imageUrl = new URL(image, seo.siteUrl).toString();
const logoUrl = identity.logo?.src ? new URL(identity.logo.src, seo.siteUrl).toString() : undefined;
const professionalImageUrl = new URL(identity.professionalImage, seo.siteUrl).toString();
const llmsUrl = new URL(aiDiscovery.llmsPath, seo.siteUrl).toString();
const markdownUrl = new URL(aiDiscovery.markdownPath, seo.siteUrl).toString();
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const structuredData: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${seo.siteUrl}/#website`,
    name: identity.siteName,
    url: seo.siteUrl,
    inLanguage: seo.language,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    '@id': `${seo.siteUrl}/#legal-service`,
    name: identity.legalName,
    url: seo.siteUrl,
    ...(logoUrl ? { logo: logoUrl } : {}),
    image: imageUrl,
    description,
    areaServed: seo.areaServed,
    knowsAbout: seo.knowsAbout,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${seo.siteUrl}/#professional`,
    name: identity.professionalName,
    jobTitle: identity.professionalRole,
    description: identity.professionalDescription,
    image: professionalImageUrl,
    worksFor: { '@id': `${seo.siteUrl}/#legal-service` },
    knowsAbout: seo.knowsAbout,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: resolvedTitle,
    description,
    inLanguage: seo.language,
    isPartOf: { '@id': `${seo.siteUrl}/#website` },
    about: { '@id': `${seo.siteUrl}/#legal-service` },
    mainEntity: { '@id': `${seo.siteUrl}/#professional` },
  },
];

if (faqItems.length) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  });
}

const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<title>{resolvedTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={identity.siteName} />
<meta name="keywords" content={seo.keywords.join(', ')} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang={seo.language} href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
{aiDiscovery.enabled && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
{aiDiscovery.enabled && <link rel="describedby" type="text/plain" href={llmsUrl} />}

<meta property="og:site_name" content={identity.siteName} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content={String(seo.defaultImageWidth)} />
<meta property="og:image:height" content={String(seo.defaultImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script is:inline type="application/ld+json" set:html={serializedStructuredData}></script>
